---
import Base from '../../../layouts/Base.astro';
import { LANGS, LANG_NAMES, profile, ui, type Lang } from '../../../data/site';
import { fmtDay, getPosts, postUrl } from '../../../lib/posts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ownPosts = await getPosts(lang);
// With nothing in this language yet, list the other languages' posts rather than an empty page.
const posts = ownPosts.length > 0 ? ownPosts : await getPosts();
const alternates = Object.fromEntries(LANGS.map((l) => [l, `/${l}/posts/`]));
---

<Base
  lang={lang}
  title={`${ui.posts[lang]} · ${profile.name[lang]}`}
  description={profile.tagline[lang]}
  path={`/${lang}/posts/`}
  alternates={alternates}
>
  <section class="posts-page">
    <h1 class="page-title">{ui.posts[lang]}</h1>
    {ownPosts.length === 0 && <p class="muted">{ui.noPostsInLang[lang]}</p>}
    <ul class="post-list">
      {
        posts.map((p) => (
          <li>
            <a href={postUrl(p)} hreflang={p.data.lang}>{p.data.title}</a>
            <div class="post-meta">
              <time datetime={p.data.date.toISOString()}>{fmtDay(p.data.date)}</time>
              {p.data.lang !== lang && <span class="post-lang">{LANG_NAMES[p.data.lang]}</span>}
            </div>
            <p>{p.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
